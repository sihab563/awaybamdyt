{
  "name": "nexus-firestore-rules-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Firebase Firestore security rules verification suite for the Nexus Android platform",
  "scripts": {
    "test:rules": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8085 node --test firestore.test.js",
    "emulators": "firebase emulators:start --only firestore,auth --project demo-no-project"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
